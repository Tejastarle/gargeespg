# Salt used to hash visitor IPs for enquiry rate limiting (any long random string)
LEAD_IP_SALT=change-me-to-a-long-random-string

# Optional: POST every new lead as JSON to this URL (Zapier / Make / n8n / Slack workflow)
LEAD_NOTIFY_WEBHOOK_URL=

# ─── Analytics (all optional) ────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Admin login ─────────────────────────────────────────
# The admin page asks for a password only. This is the hidden account it signs in to;
# it must match v_email in supabase/create-admin.sql. Leave as is unless you changed it there.
NEXT_PUBLIC_ADMIN_EMAIL=admin@gargeespg.com

# ─── Demo mode ───────────────────────────────────────────
# When Supabase is NOT configured, "true" lets you explore the admin panel with sample
# data and test the enquiry form without saving anything. Keep "false" in production.
NEXT_PUBLIC_DEMO_MODE=true
